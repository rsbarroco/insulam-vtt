# Non-secret values only. Keep the filled file outside the source checkout.
# Replace every CHANGE_ME value; this example does not launch a stack.
VTT_PROJECT_NAME=vtt
VTT_DATA_DIR=CHANGE_ME_ABSOLUTE_DATA_DIRECTORY
VTT_SECRETS_DIR=CHANGE_ME_ABSOLUTE_SECRET_DIRECTORY
VTT_PROXY_NETWORK=CHANGE_ME_EXISTING_PROXY_NETWORK
VTT_PROXY_ALIAS=vtt-proxy
VTT_TRUSTED_PROXIES=CHANGE_ME_EXACT_PROXY_ADDRESS
VTT_BACKEND_IMAGE=CHANGE_ME_RELEASE_BACKEND_IMAGE
VTT_FRONTEND_IMAGE=CHANGE_ME_RELEASE_FRONTEND_IMAGE
VITE_SOURCE_CODE_URL=CHANGE_ME_PUBLIC_FULL_COMMIT_URL
DATABASE_USER=vtt
DATABASE_NAME=vtt
CORS_ORIGIN=https://vtt.example.invalid
APP_URL=https://vtt.example.invalid
